{
    "name": "miminet-front-web",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "Vite/TypeScript build pipeline for miminet front-end JS.",
    "scripts": {
        "build": "vite build",
        "dev": "vite build --watch",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "prepare": "cd ../.. && husky front/web/.husky || true"
    },
    "lint-staged": {
        "*.{ts,tsx,js}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{json,md,yml,yaml}": [
            "prettier --write"
        ]
    },
    "devDependencies": {
        "@eslint/js": "^9.39.4",
        "@types/cytoscape": "^3.21.9",
        "@types/jquery": "^4.0.0",
        "@types/node": "^25.8.0",
        "@types/react": "^18.3.28",
        "@types/react-dom": "^18.3.7",
        "@vitejs/plugin-react": "^4.7.0",
        "cytoscape": "^3.33.3",
        "eslint": "^9.39.4",
        "eslint-config-prettier": "^9.1.2",
        "husky": "^9.1.7",
        "lint-staged": "^15.5.2",
        "prettier": "^3.8.3",
        "typescript": "^5.6.0",
        "typescript-eslint": "^8.59.4",
        "vite": "^5.4.0"
    },
    "dependencies": {
        "react": "^18.3.1",
        "react-dom": "^18.3.1"
    }
}
